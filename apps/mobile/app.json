{
  "expo": {
    "name": "BizMonitor GE",
    "slug": "bizmonitor-ge",
    "scheme": "bizmonitor",
    "version": "1.0.3",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "ge.bizmonitor.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Unlock your business dashboard securely.",
        "NSLocalNetworkUsageDescription": "Connect to your Mac running the BizMonitor server on the same network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      },
      "buildNumber": "4"
    },
    "android": {
      "package": "ge.bizmonitor.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      "expo-notifications",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ]
    ],
    "updates": {
      "enabled": false
    }
  }
}
